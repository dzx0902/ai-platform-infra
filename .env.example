APP_ENV=production
TIMEZONE=Asia/Shanghai

# Paths are Docker-visible repository locations. Keep all runtime data in named volumes.
WORKSPACE_AGENT_PATH=../ai_workspace
PAPER_AGENT_PATH=../paper_radar_agent
PLANNER_AGENT_PATH=../daily_planner_agent
FINANCE_AGENT_PATH=../stock-data-analyzer

POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=replace-me
POSTGRES_URL=postgresql://ai_platform:replace-me@postgres:5432/ai_platform
REDIS_URL=redis://redis:6379/0
CHROMA_URL=http://chromadb:8000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

KNOWLEDGE_GIT_REPOSITORY=
KNOWLEDGE_GIT_BRANCH=main
KNOWLEDGE_GIT_AUTHOR_NAME=AI Platform
KNOWLEDGE_GIT_AUTHOR_EMAIL=ai-platform@localhost
